TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
ADMIN_TELEGRAM_IDS=123456789,987654321
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Tesseract OCR path (Linux: /usr/bin/tesseract | macOS Homebrew: /opt/homebrew/bin/tesseract | Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=/usr/bin/tesseract
MAX_UPLOAD_MB=10
MIN_TEMPLATE_CONFIDENCE=0.72
LOW_CONFIDENCE_THRESHOLD=0.82

STORE_ORIGINAL_IMAGES=false
STORE_OCR_TEXT=true
TEMP_FILE_RETENTION_MINUTES=15

RATE_LIMIT_UPLOADS_PER_MINUTE=5
LOG_LEVEL=INFO
ENVIRONMENT=development

# Samples & Storage Configuration
SAMPLES_DIR=/Users/snehithchalasani/Stuff/Reci-Edit-Bot/Samples
STORAGE_DIR=storage
WATERMARK_NON_OFFICIAL=true
PDF_DPI=300
