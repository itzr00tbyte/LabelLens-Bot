# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_IDS=[123456789,987654321]

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Tesseract OCR Executable Path for Linux
# Standard Debian/Ubuntu/Fedora/Docker install path:
TESSERACT_CMD=/usr/bin/tesseract
# Note: If installed from source or custom path, could be /usr/local/bin/tesseract

# Processing Settings
MAX_UPLOAD_MB=10
MIN_TEMPLATE_CONFIDENCE=0.50
LOW_CONFIDENCE_THRESHOLD=0.50

# Storage & Cleanup Settings
STORE_ORIGINAL_IMAGES=true
STORE_OCR_TEXT=true
TEMP_FILE_RETENTION_MINUTES=15

# Security & Operations
RATE_LIMIT_UPLOADS_PER_MINUTE=0
LOG_LEVEL=INFO
ENVIRONMENT=development
