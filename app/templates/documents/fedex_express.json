{
  "id": "fedex_express",
  "name": "FedEx Express",
  "category": "fedex_shipping_label",
  "version": 1,
  "priority": 90,
  "enabled": true,
  "required_keywords": [
    "FEDEX",
    "EXPRESS"
  ],
  "optional_keywords": [
    "TRACKING",
    "PRIORITY",
    "OVERNIGHT",
    "DELIVERY",
    "TRK#"
  ],
  "excluded_keywords": [
    "GROUND",
    "HOME DELIVERY",
    "RETURN",
    "USPS",
    "UPS",
    "DHL"
  ],
  "regex_indicators": [
    "\\b\\d{12}\\b",
    "\\b\\d{15}\\b"
  ],
  "minimum_score": 0.7,
  "fields": {
    "carrier": {
      "type": "constant",
      "value": "FedEx"
    },
    "service": {
      "type": "constant",
      "value": "FedEx Express"
    },
    "tracking_number": {
      "type": "regex",
      "patterns": [
        "TRK[#F]?\\s*(\\d{4}\\s*\\d{4}\\s*\\d{4})",
        "\\b\\d{12}\\b",
        "\\b\\d{15}\\b",
        "\\b\\d{20}\\b"
      ],
      "required": true,
      "normalize": "digits_only"
    }
  },
  "actions": [
    "approve",
    "correct",
    "rescan",
    "reject",
    "details"
  ]
}