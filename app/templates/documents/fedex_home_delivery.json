{
  "id": "fedex_home_delivery",
  "name": "FedEx Home Delivery",
  "category": "fedex_shipping_label",
  "version": 1,
  "priority": 100,
  "enabled": true,
  "required_keywords": [
    "HOME DELIVERY"
  ],
  "optional_keywords": [
    "FEDEX",
    "FEDS",
    "FED2X",
    "TRK#",
    "CAD:",
    "FROM:",
    "TO"
  ],
  "excluded_keywords": [
    "RETURN",
    "RMA:",
    "USPS",
    "UPS",
    "DHL"
  ],
  "regex_indicators": [
    "HOME DELIVERY",
    "\\bTRK#?\\s*\\d{4}\\s*\\d{4}\\s*\\d{4}\\b",
    "\\b\\d{12}\\b"
  ],
  "minimum_score": 0.5,
  "fields": {
    "carrier": {
      "type": "constant",
      "value": "FedEx"
    },
    "service": {
      "type": "constant",
      "value": "FedEx Home Delivery"
    },
    "tracking_number": {
      "type": "regex",
      "patterns": [
        "TRK[#F]?\\s*(\\d{4}\\s*\\d{4}\\s*\\d{4})",
        "TRK#?\\s*(\\d{4}\\s*\\d{4}\\s*\\d{4})",
        "\\b(\\d{12})\\b"
      ],
      "required": true,
      "normalize": "digits_only"
    },
    "recipient_name": {
      "type": "anchored_text",
      "anchor": "TO"
    },
    "recipient_address": {
      "type": "anchored_block",
      "anchor": "TO"
    }
  },
  "actions": [
    "approve",
    "correct",
    "rescan",
    "reject",
    "details"
  ]
}