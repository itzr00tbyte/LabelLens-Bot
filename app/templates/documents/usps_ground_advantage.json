    "POSTAGE",
    "PACKAGE PICKUP",
    "POST OFFICE",
    "EPAS",
    "PRIORITY",
    "U.S. POSTAGE"
  ],
  "excluded_keywords": [
    "FEDEX",
    "UPS",
    "DHL"
  ],
  "regex_indicators": [
    "\\b(?:94\\d{20}|92\\d{20}|93\\d{20}|\\d{22}|(?:\\d[ ]*){20,22})\\b"
  ],
  "minimum_score": 0.72,
  "fields": {
