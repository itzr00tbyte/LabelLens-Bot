{
  "id": "usps_ground_advantage",
  "name": "USPS Ground Advantage",
  "category": "usps_shipping_label",
  "version": 1,
  "priority": 100,
  "enabled": true,
  "required_keywords": [
    "USPS",
    "GROUND ADVANTAGE",
    "TRACKING"
  ],
  "optional_keywords": [
