        "\\b(?:94\\d{20}|92\\d{20}|93\\d{20}|\\d{22}|(?:\\d[ ]*){20,22})\\b"
      ],
      "required": true,
      "normalize": "digits_only"
    },
    "recipient_name": {
      "type": "anchored_text",
